#pragma code_page(65001)

#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1
#define RT_MANIFEST 24

101 ICON "@ESN_ICON_PATH@"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@ESN_MANIFEST_PATH@"

1 VERSIONINFO
FILEVERSION @ESN_VERSION_COMMA@
PRODUCTVERSION @ESN_VERSION_COMMA@
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "ESN"
      VALUE "FileDescription",  "ESN"
      VALUE "FileVersion",      "@PROJECT_VERSION@.0"
      VALUE "InternalName",     "ESN"
      VALUE "LegalCopyright",   "MIT License"
      VALUE "OriginalFilename", "ESN.exe"
      VALUE "ProductName",      "ESN"
      VALUE "ProductVersion",   "@PROJECT_VERSION@.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
